{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "minato-studio-wedding",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/e2e/**",
      "assets/demo-wedding-2027/**",
      "assets/*/README.md"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/w/:slug/info",
        "destination": "/w/:slug/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/assets/*/manifest.json",
        "destination": "/assets/empty-manifest.json"
      },
      {
        "source": "/w/*/rsvp",
        "destination": "/rsvp.html"
      },
      {
        "source": "/w/*/wall",
        "destination": "/wall.html"
      },
      {
        "source": "/w/*/cake",
        "destination": "/cake.html"
      },
      {
        "source": "/w/*/draw",
        "destination": "/draw.html"
      },
      {
        "source": "/w/*/exhibition",
        "destination": "/exhibition.html"
      },
      {
        "source": "/w/*/quiz",
        "destination": "/quiz.html"
      },
      {
        "source": "/w/*/inbox",
        "destination": "/inbox.html"
      },
      {
        "source": "/w/*/invitation",
        "destination": "/invitation.html"
      },
      {
        "source": "/w/**",
        "destination": "/index.html"
      },
      {
        "source": "/s/**",
        "destination": "/shortlink.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
