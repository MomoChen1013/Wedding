{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "site": "minato-studio-wedding",
    "public": "public",
    "predeploy": [
      "npm run build-og",
      "npm run build-sample-shield"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "assets/e2e/**",
      "assets/demo-wedding-2027/**",
      "assets/*/README.md"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "regex": "(?:^/(?:$|[^s].*|s(?:$|[^a].*|a(?:$|[^m].*|m(?:$|[^p].*|p(?:$|[^l].*|l(?:$|[^e].*|e(?:$|[^s].*|s[^/].*)))))))$)|(?:^/samples/[a-z0-9-]+(?:/.*)?$)",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "tdm-reservation",
            "value": "1"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/w/:slug/info",
        "destination": "/w/:slug/",
        "type": 301
      },
      {
        "source": "/w/:slug/rsvp",
        "destination": "/w/:slug/invitation",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/assets/*/manifest.json",
        "destination": "/assets/empty-manifest.json"
      },
      {
        "source": "/samples/*/wall",
        "destination": "/wall.html"
      },
      {
        "source": "/samples/*/cake",
        "destination": "/cake.html"
      },
      {
        "source": "/samples/*/draw",
        "destination": "/draw.html"
      },
      {
        "source": "/samples/*/exhibition",
        "destination": "/exhibition.html"
      },
      {
        "source": "/samples/*/quiz",
        "destination": "/quiz.html"
      },
      {
        "source": "/samples/*/seating",
        "destination": "/seating.html"
      },
      {
        "source": "/samples/*/letter",
        "destination": "/letter.html"
      },
      {
        "source": "/samples/*/invitation",
        "destination": "/invitation.html"
      },
      {
        "source": "/samples/**",
        "destination": "/index.html"
      },
      {
        "source": "/w/*/wall",
        "destination": "/wall.html"
      },
      {
        "source": "/w/*/cake",
        "destination": "/cake.html"
      },
      {
        "source": "/w/*/draw",
        "destination": "/draw.html"
      },
      {
        "source": "/w/*/exhibition",
        "destination": "/exhibition.html"
      },
      {
        "source": "/w/*/quiz",
        "destination": "/quiz.html"
      },
      {
        "source": "/w/*/seating",
        "destination": "/seating.html"
      },
      {
        "source": "/w/*/letter",
        "destination": "/letter.html"
      },
      {
        "source": "/w/*/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/w/*/invitation",
        "destination": "/invitation.html"
      },
      {
        "source": "/w/**",
        "destination": "/index.html"
      },
      {
        "source": "/s/**",
        "destination": "/shortlink.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
