  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore,hosting,auth \"node tests/e2e.mjs\"",
    "test:multipage": "firebase emulators:exec --only firestore,hosting,auth \"node tests/multipage.mjs\"",
    "test:butler": "firebase emulators:exec --only firestore,hosting,auth \"node tests/butler.mjs\"",
    "test:ui": "firebase emulators:exec --only hosting \"node tests/ui-consistency.mjs\"",
    "test:no-flicker": "firebase emulators:exec --only firestore,hosting,auth \"node tests/seed-no-flicker.mjs && node scripts/build-og.js --project wedding-22b94 --text none && node tests/no-flicker.mjs\"",
    "test:all": "npm run test:rules && npm run test:e2e && npm run test:multipage && npm run test:butler && npm run test:ui && npm run test:no-flicker",
    "emulators": "firebase emulators:start --only firestore,hosting,auth",
    "samples": "echo 版型展示頁：http://localhost:5000/samples/ && firebase emulators:start --only hosting",
    "create-site": "node scripts/create-site.js",
    "export-rsvps": "node scripts/export-rsvps.js",
    "create-short-link": "node scripts/create-short-link.js",
    "sync-assets": "node scripts/sync-assets.js",
    "build-og": "node scripts/build-og.js",
    "check-site": "node scripts/check-site.js",
    "set-pages": "node scripts/set-pages.js",
    "build-previews": "node scripts/build-previews.js",
    "build-samples": "node scripts/build-samples.js",
    "build-sample-thumbs": "node scripts/build-sample-thumbs.js && node scripts/build-samples.js",
    "build-sample-videos": "node scripts/build-sample-videos.js && node scripts/build-samples.js",
    "build-sample-shield": "node scripts/build-sample-shield.js",
    "migrate-site-owners": "node scripts/migrate-site-owners.js"
  },
