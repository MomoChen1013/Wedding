rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- 共用 helper ---------- */

    function site(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data;
    }

    /* 站台必須存在且已發布，未發布的站台一律不能寫入 */
    function sitePublished(siteId) {
      return exists(/databases/$(database)/documents/sites/$(siteId))
        && site(siteId).status == 'published';
    }

    /* 該站台有沒有開啟這個頁面；沒設定 pages 就視為全開 */
    function pageOn(siteId, key) {
      let s = site(siteId);
      return !('pages' in s) || s.pages[key] == true;
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    /* 是不是這組新人本人：用已驗證的 Google 信箱比對站台的白名單。
       信箱由 Firebase Auth 簽發，前端偽造不了，才是真正的保護。 */
    function isSiteOwner(siteId) {
      let s = site(siteId);
      return request.auth != null
        && request.auth.token.email_verified == true
        && 'ownerEmails' in s
        && s.ownerEmails is list
        && request.auth.token.email in s.ownerEmails;
    }

    /* 賓客留下的內容共用的基本欄位：暱稱、icon、時間 */
    function validAuthor(data) {
      return isStr(data.name, 40)
        && isStr(data.icon, 8)
        && data.time is number;
    }

    /* 新人在後台可以改的站台欄位：只有大廳看得到的文案。
       slug／status／ownerEmails／pages／rsvp* 一律不在名單內 ——
       那些欄位是規則自己的判斷依據，能改的話等於能自己開後門。
       guestTagsEnabled 與 entryLoginEnabled 也不在名單內：它們不參與規則判斷，
       但一改就動到整站的用法（要不要用標籤、賓客要不要先報上名來），
       和 pages 一樣由我們用 Admin SDK／Console 決定哪一組新人要用。 */
    function isValidSiteContentUpdate(siteId) {
      let d = request.resource.data;
      return isSiteOwner(siteId)
        && d.diff(resource.data).affectedKeys().hasOnly([
             'coupleTitle', 'venueName', 'venueAddress', 'venueMapUrl',
             'transportPublic', 'transportParking',
             'transportPublicImg', 'transportParkingImg',
             'dressCode', 'giftNote', 'story', 'schedule', 'hashtags',
             'seatingSearchEnabled', 'updatedAt',
             /* 出席回覆頁的題目與區塊開關：只改變賓客看到的表單長什麼樣，
                規則本身不拿它們做任何判斷（能不能寫回覆仍然只看
                rsvpEnabled／rsvpDeadline，那兩個依舊改不動）。 */
             'rsvpAskCard', 'rsvpAskGift', 'rsvpAskMessage',
             'rsvpContactMethods', 'rsvpShowStory', 'rsvpShowGallery',
             /* 賓客標籤庫（VIP、長輩、大學同學…）：新人自己維護，
                但「這個站台要不要用標籤」的總開關 guestTagsEnabled
                不在名單內 —— 和 pages 一樣，只能由我們用 Admin SDK／
                Console 打開，新人不會自己誤觸一個還沒教過的功能。 */
             'guestTags',
             'seatingSearchEnabled', 'seatingFeatureEnabled', 'eventDate', 'updatedAt',
           ])
        /* 只放行「幾點開始」：後台只送整個 Timestamp 進來（年月日沿用原本設定好的），
           日期本身還是要透過我們才能改，不然出席回覆的判斷、網址都可能跟著跑掉 */
        && (!('eventDate' in d) || d.eventDate is timestamp)
        /* 大廳資訊卡上的稱呼，後台限 20 個字 */
        && (!('coupleTitle'  in d) || isStr(d.coupleTitle, 20))
        && (!('venueName'    in d) || isStr(d.venueName, 80))
        && (!('venueAddress' in d) || isStr(d.venueAddress, 200))
        && (!('venueMapUrl'  in d) || (isStr(d.venueMapUrl, 500)
             && (d.venueMapUrl == '' || d.venueMapUrl.matches('https?://.*'))))
        && (!('transportPublic'  in d) || isStr(d.transportPublic, 500))
        && (!('transportParking' in d) || isStr(d.transportParking, 500))
        /* 交通資訊配的圖：跟很多文字欄位共用同一份文件，上限比獨立子集合的圖片更嚴格 */
        && (!('transportPublicImg' in d) || (isStr(d.transportPublicImg, 300000)
             && (d.transportPublicImg == '' || d.transportPublicImg.matches('data:image/.*'))))
        && (!('transportParkingImg' in d) || (isStr(d.transportParkingImg, 300000)
             && (d.transportParkingImg == '' || d.transportParkingImg.matches('data:image/.*'))))
        && (!('dressCode' in d) || isStr(d.dressCode, 500))
        && (!('giftNote'  in d) || isStr(d.giftNote, 500))
        && (!('story'     in d) || isStr(d.story, 2000))
        /* 桌次搜尋的開關：只影響賓客那一頁的畫面，不是規則的判斷依據 */
        && (!('seatingSearchEnabled' in d) || d.seatingSearchEnabled is bool)
        /* 桌次功能的總開關：關著的時候大廳不出現「尋找我的座位」、
           導覽列也不放桌次。和 pages 不一樣的是它不參與任何規則判斷
           （桌次名單本來就只有新人寫得進去），所以放行給新人自己控制 —— 
           婚禮當天才打開，賓客就不會提早跑去找位子。 */
        && (!('seatingFeatureEnabled' in d) || d.seatingFeatureEnabled is bool)
        /* 出席回覆的題目開關，同理 */
        && (!('rsvpAskCard'    in d) || d.rsvpAskCard is bool)
        && (!('rsvpAskGift'    in d) || d.rsvpAskGift is bool)
        && (!('rsvpAskMessage' in d) || d.rsvpAskMessage is bool)
        && (!('rsvpShowStory'   in d) || d.rsvpShowStory is bool)
        && (!('rsvpShowGallery' in d) || d.rsvpShowGallery is bool)
        /* 要問哪幾種聯絡方式；最多就那三種，規則語言檢查不了每個元素的值，
           只擋筆數與型別，內容在後台送出前先切好 */
        && (!('rsvpContactMethods' in d)
            || (d.rsvpContactMethods is list && d.rsvpContactMethods.size() <= 3))
        /* schedule 的每一筆是 map，規則語言沒辦法逐筆檢查內容，
           只擋住筆數與型別；真正的長度限制在後台送出前先切好。 */
        && (!('schedule' in d) || (d.schedule is list && d.schedule.size() <= 40))
        /* 婚禮 hashtag 最多 3 個 */
        && (!('hashtags' in d) || (d.hashtags is list && d.hashtags.size() <= 3))
        /* 標籤庫的每一筆是 map（id／name／onForm），規則語言沒辦法逐筆檢查，
           所以和 schedule 同一套做法：只擋筆數與型別，
           每一筆的內容在後台送出前先切好、擋好。 */
        && (!('guestTags' in d) || (d.guestTags is list && d.guestTags.size() <= 30));
    }

    /* ---------- sites ---------- */
    match /sites/{siteId} {
      allow read: if true;
      /* 新人只改得動大廳文案，其餘欄位（含站台本身的建立與刪除）走 Admin SDK */
      allow update: if isValidSiteContentUpdate(siteId);
      allow create, delete: if false;

      /* 出席回覆：任何人都可以新增（需通過驗證），
         但只有新人本人讀得到 —— 和悄悄話信箱同一套身分判斷。
         賓客彼此看不到誰要來、留了什麼話、有什麼飲食禁忌。

         仍然不開放 update／delete：回覆是賓客送出的紀錄，
         新人可以看、可以匯出，但不該在後台改掉別人寫的內容。
         真的要刪（測試資料、重複回覆）走 Admin SDK。 */
      match /rsvps/{rsvpId} {
        allow create: if isValidRsvp(request.resource.data, siteId);
        allow read: if isSiteOwner(siteId);
        allow update, delete: if false;
      }

      /* 新人幫賓客掛的標籤（VIP、長輩、行動不便…），一位賓客可以有好幾個。
         刻意不寫回 rsvps —— 回覆是賓客送出的紀錄，仍然一個字都不能改；
         新人自己整理的分類另外存一份，文件 id 就用那筆回覆的 id，
         兩邊對得起來，之後排桌次也是讀這一份。
         賓客讀不到（和 rsvps 一樣只有 ownerEmails 讀得到）。 */
      match /rsvpTags/{rsvpId} {
        allow read: if isSiteOwner(siteId);
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['tags', 'updatedAt'])
          && request.resource.data.tags is list
          && request.resource.data.tags.size() <= 20
          && request.resource.data.updatedAt is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 祝福牆 */
      match /wishes/{wishId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'wall')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'text', 'time'])
          && validAuthor(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      /* 悄悄話信箱：只有站台 ownerEmails 名單內、且信箱已驗證的
         Google 帳號讀得到。賓客寫得進去、讀不出來。 */
      match /letters/{letterId} {
        allow read: if isSiteOwner(siteId);
        allow create: if sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'text', 'time'])
          && validAuthor(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      /* 甜點桌 */
      match /cakes/{cakeId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'cake')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'cake', 'emoji', 'img', 'time'])
          && validAuthor(request.resource.data)
          && isStr(request.resource.data.cake, 60)
          && isStr(request.resource.data.emoji, 8)
          && isStr(request.resource.data.img, 300);
        allow update, delete: if false;
      }

      /* 新人小測驗的題目：新人在後台出題，賓客只讀得到。
         固定四個選項，answer 是正確答案的索引陣列（單選只有一個）。
         規則語言沒辦法逐一檢查 list 裡每個元素的型別與長度，
         所以「選項幾個字、索引是不是 0–3」在後台送出前先切好、擋好。 */
      match /quiz/{questionId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['type', 'q', 'opts', 'answer', 'order', 'time'])
          && request.resource.data.type in ['single', 'multi']
          && isStr(request.resource.data.q, 60)
          && request.resource.data.q.size() >= 1
          && request.resource.data.opts is list
          && request.resource.data.opts.size() == 4
          && request.resource.data.answer is list
          && request.resource.data.answer.size() >= 1
          && request.resource.data.answer.size() <= 4
          && (request.resource.data.type == 'multi'
              || request.resource.data.answer.size() == 1)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 測驗的作答紀錄：賓客送上來的票，不含個資。
         picks 是「題目 id → 選了哪幾個選項」的 map ——
         Firestore 的陣列不能再放陣列，所以外層一定是 map。 */
      match /quizVotes/{voteId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'quiz')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['picks', 'score', 'total', 'time'])
          && request.resource.data.picks is map
          && request.resource.data.picks.size() <= 50
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.total is int
          && request.resource.data.total >= 0
          && request.resource.data.total <= 50
          && request.resource.data.time is number;
        /* 票是賓客送出的紀錄，不可修改；新人可以在後台整批清空重新統計 */
        allow update: if false;
        allow delete: if isSiteOwner(siteId);
      }

      /* 抽卡收藏：每位訪客只看得到自己的卡 */
      match /collected/{cardId} {
        allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;
        allow create: if pageOn(siteId, 'draw')
          && sitePublished(siteId)
          && request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'userName', 'art', 'name', 'rarity', 'desc', 'cardId', 'time'])
          && isStr(request.resource.data.userName, 40)
          && isStr(request.resource.data.name, 60)
          /* art 存的是圖片網址或符號，長度有限；新人自己上傳的卡圖是整段
             data URL，塞不進這裡，所以改存 cardId，畫面再回 cards 取圖。 */
          && isStr(request.resource.data.art, 300)
          && isStr(request.resource.data.rarity, 8)
          && (!('desc' in request.resource.data) || isStr(request.resource.data.desc, 200))
          && (!('cardId' in request.resource.data) || isStr(request.resource.data.cardId, 60))
          && request.resource.data.time is number;
        allow update, delete: if false;
      }

      /* 愛心計數器：只有 count 一個欄位，且只能往上加 1 */
      match /meta/hearts {
        allow read: if true;
        allow write: if pageOn(siteId, 'wall')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && (
            !exists(/databases/$(database)/documents/sites/$(siteId)/meta/hearts)
            ? request.resource.data.count == 1
            : request.resource.data.count == resource.data.count + 1
          );
      }

      /* 信件數量：賓客讀不到信件內容，但看得到「已有幾封信」。
         同樣只能一次加一，避免被亂設數字。 */
      match /meta/letterCount {
        allow read: if true;
        allow write: if sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && (
            !exists(/databases/$(database)/documents/sites/$(siteId)/meta/letterCount)
            ? request.resource.data.count == 1
            : request.resource.data.count == resource.data.count + 1
          );
      }

      /* ---------- 婚禮當天：桌次查詢 ----------
         名單必須公開讀取，賓客才查得到自己的位子
         （等同於會場門口那張貼出來的座位表）。
         寫入只有新人本人（ownerEmails 白名單）做得到。 */
      match /seating/{seatId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['name', 'table', 'note', 'time'])
          && isStr(request.resource.data.name, 40)
          && request.resource.data.name.size() >= 1
          && isStr(request.resource.data.table, 40)
          && request.resource.data.table.size() >= 1
          && isStr(request.resource.data.note, 100)
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 桌次圖：新人在後台上傳，前端先縮圖再以 data URL 存進文件。
         不開 Firebase Storage —— Storage 規則讀不到 Firestore，
         沒辦法用 ownerEmails 白名單判斷身分。 */
      match /seatingImages/{imageId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['img', 'title', 'order', 'time'])
          && request.resource.data.img is string
          && request.resource.data.img.size() <= 950000
          && request.resource.data.img.matches('data:image/.*')
          && isStr(request.resource.data.title, 60)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 電子祝福信：新人寫好，賓客用名字或專屬詞彙領取。
         比對在前端做，所以信件內容是公開可讀的
         —— 這裡適合寫給某人的祝福，不適合放不能被看到的祕密。
         欄位取名 terms 而不是 keys，避免和規則語言的 data.keys() 撞名。 */
      match /blessings/{blessingId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['terms', 'title', 'body', 'sign', 'isDefault', 'time'])
          && request.resource.data.terms is list
          && request.resource.data.terms.size() <= 20
          && isStr(request.resource.data.title, 60)
          && isStr(request.resource.data.body, 2000)
          && request.resource.data.body.size() >= 1
          && isStr(request.resource.data.sign, 60)
          && request.resource.data.isDefault is bool
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 首頁 Explore 區的自訂卡片：新人自己寫這場婚禮規劃了什麼。
         kind='link'  → 點了開外部連結（只收 http(s)，擋掉 javascript: 之類）
         kind='popup' → 點了跳出 body 的內文 */
      match /explore/{itemId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['title', 'sub', 'kind', 'url', 'body', 'order', 'time'])
          && isStr(request.resource.data.title, 40)
          && request.resource.data.title.size() >= 1
          && isStr(request.resource.data.sub, 120)
          && request.resource.data.kind in ['link', 'popup']
          && isStr(request.resource.data.url, 500)
          && (request.resource.data.kind != 'link'
              || request.resource.data.url.matches('https?://.*'))
          && isStr(request.resource.data.body, 2000)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 囍卡：新人在後台裁切上傳自己的照片，順便設等級與說明。
         和桌次圖同一套做法（data URL 存進文件），原因見 seatingImages。
         這個集合有東西時，抽卡頁就整批用它，不再讀素材資料夾。 */
      match /cards/{cardId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['img', 'name', 'rarity', 'desc', 'order', 'time'])
          && request.resource.data.img is string
          && request.resource.data.img.size() <= 950000
          && request.resource.data.img.matches('data:image/.*')
          && isStr(request.resource.data.name, 60)
          && request.resource.data.rarity in ['SSR', 'SR', 'R', 'N']
          && isStr(request.resource.data.desc, 200)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 戀愛時光的展品與章節分隔卡。
         kind='photo' → 一張展品照（img 可以留空，只放文字）
         kind='act'   → 章節分隔卡，title 是章節名、sub 是副標
         沒有照片的展品也收，新人可以先寫文字之後再補圖。 */
      match /exhibits/{exhibitId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['kind', 'img', 'title', 'sub', 'desc', 'year', 'act', 'order', 'time'])
          && request.resource.data.kind in ['photo', 'act']
          && request.resource.data.img is string
          && request.resource.data.img.size() <= 950000
          && (request.resource.data.img == ''
              || request.resource.data.img.matches('data:image/.*'))
          && isStr(request.resource.data.title, 60)
          && isStr(request.resource.data.sub, 60)
          && isStr(request.resource.data.desc, 500)
          && isStr(request.resource.data.year, 20)
          && isStr(request.resource.data.act, 40)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 其他 meta 文件一律不開放 */
      match /meta/{docId} {
        allow read: if true;
        allow write: if false;
      }
    }

    /* 0–10 之間的整數（人數、張數這類欄位共用） */
    function isCount(v) {
      return v is int && v >= 0 && v <= 10;
    }

    /* RSVP 建立時的欄位與商業規則驗證
       ------------------------------------------------------------
       核心欄位（name／attending／guestCount／dietaryNote／message／createdAt）
       一定要有；其餘都是選填 —— 舊版表單送出的回覆仍然收得下。

         tentative    true 代表「視情況而定」（此時 attending 為 false）
         relation     與新人的關係
         mealMeat／mealVeg   葷素分配，加起來等於 guestCount
         childSeat    兒童座椅張數，0 代表不需要
         cardType     喜帖形式：paper／digital／none
         cardDelivery 紙本喜帖的給法：pickup／mail（其餘情況為空字串）
         cardZip／cardAddress    喜帖郵寄地址
         giftDelivery 喜餅：pickup／mail
         giftZip／giftAddress    喜餅郵寄地址
         note         其他備註
         meal         舊版表單的單一餐點欄位，保留相容

       規則只認得「型別、長度、值域」這種結構性條件；
       「選了郵寄就一定要有地址」這種跨欄位的商業邏輯
       在 js/rsvp-form.js 送出前先擋好（規則語言寫得出來，
       但寫進去等於把表單邏輯複製一份，日後兩邊會走鐘）。 */
    function isValidRsvp(data, siteId) {
      let s = site(siteId);
      return data.keys().hasOnly([
             'name', 'attending', 'guestCount', 'dietaryNote', 'message', 'createdAt',
             'icon', 'tentative', 'meal', 'relation', 'mealMeat', 'mealVeg', 'childSeat',
             'contactPhone', 'contactLine', 'contactEmail',
             'cardType', 'cardDelivery', 'cardZip', 'cardAddress', 'cardEmail',
             'giftDelivery', 'giftZip', 'giftAddress', 'note', 'tag',
           ])
        && data.keys().hasAll(['name', 'attending', 'guestCount', 'dietaryNote', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.attending is bool
        && data.guestCount is int && data.guestCount >= 1 && data.guestCount <= 10
        && data.dietaryNote is string && data.dietaryNote.size() <= 300
        && data.message is string && data.message.size() <= 300
        && data.createdAt == request.time
        && (!('icon' in data) || isStr(data.icon, 8))
        && (!('tentative' in data) || data.tentative is bool)
        && (!('meal' in data) || isStr(data.meal, 20))
        && (!('note' in data) || isStr(data.note, 300))
        && (!('relation' in data) || data.relation in ['groom', 'bride', 'both', 'other', ''])
        && (!('mealMeat' in data) || isCount(data.mealMeat))
        && (!('mealVeg' in data) || isCount(data.mealVeg))
        && (!('childSeat' in data) || isCount(data.childSeat))
        && (!('contactPhone' in data) || isStr(data.contactPhone, 30))
        && (!('contactLine' in data) || isStr(data.contactLine, 60))
        && (!('contactEmail' in data) || isStr(data.contactEmail, 120))
        && (!('cardType' in data) || data.cardType in ['paper', 'digital', 'none', ''])
        && (!('cardDelivery' in data) || data.cardDelivery in ['pickup', 'mail', ''])
        && (!('cardZip' in data) || isStr(data.cardZip, 10))
        && (!('cardAddress' in data) || isStr(data.cardAddress, 200))
        && (!('cardEmail' in data) || isStr(data.cardEmail, 120))
        && (!('giftDelivery' in data) || data.giftDelivery in ['pickup', 'mail', ''])
        && (!('giftZip' in data) || isStr(data.giftZip, 10))
        && (!('giftAddress' in data) || isStr(data.giftAddress, 200))
        /* 賓客自己選的那一個標籤（單選，選填）。存的是標籤 id，
           規則不知道站台目前有哪些標籤（list 裡是 map，查不了），
           所以只擋長度；沒開這個功能的站台一律只能是空字串。 */
        && (!('tag' in data) || (isStr(data.tag, 40)
             && (data.tag == ''
                 || (('guestTagsEnabled' in s) && s.guestTagsEnabled == true))))
        && sitePublished(siteId)
        && s.rsvpEnabled == true
        && request.time <= s.rsvpDeadline;
    }

    /* slugs：前端要查 slug → siteId，寫入走 Admin SDK */
    match /slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    /* 短連結：前端只能讀，寫入走 Admin SDK */
    match /short/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
