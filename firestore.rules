rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- 共用 helper ---------- */

    function site(siteId) {
      return get(/databases/$(database)/documents/sites/$(siteId)).data;
    }

    /* 站台必須存在且已發布，未發布的站台一律不能寫入 */
    function sitePublished(siteId) {
      return exists(/databases/$(database)/documents/sites/$(siteId))
        && site(siteId).status == 'published';
    }

    /* 該站台有沒有開啟這個頁面；沒設定 pages 就視為全開 */
    function pageOn(siteId, key) {
      let s = site(siteId);
      return !('pages' in s) || s.pages[key] == true;
    }

    function isStr(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    /* 是不是這組新人本人：用已驗證的 Google 信箱比對站台的白名單。
       信箱由 Firebase Auth 簽發，前端偽造不了，才是真正的保護。 */
    function isSiteOwner(siteId) {
      let s = site(siteId);
      return request.auth != null
        && request.auth.token.email_verified == true
        && 'ownerEmails' in s
        && s.ownerEmails is list
        && request.auth.token.email in s.ownerEmails;
    }

    /* 賓客留下的內容共用的基本欄位：暱稱、icon、時間 */
    function validAuthor(data) {
      return isStr(data.name, 40)
        && isStr(data.icon, 8)
        && data.time is number;
    }

    /* ---------- sites ---------- */
    match /sites/{siteId} {
      allow read: if true;
      allow create, update, delete: if false;

      /* 出席回覆：任何人都可以新增（需通過驗證），
         但只有新人本人讀得到 —— 和悄悄話信箱同一套身分判斷。
         賓客彼此看不到誰要來、留了什麼話、有什麼飲食禁忌。

         仍然不開放 update／delete：回覆是賓客送出的紀錄，
         新人可以看、可以匯出，但不該在後台改掉別人寫的內容。
         真的要刪（測試資料、重複回覆）走 Admin SDK。 */
      match /rsvps/{rsvpId} {
        allow create: if isValidRsvp(request.resource.data, siteId);
        allow read: if isSiteOwner(siteId);
        allow update, delete: if false;
      }

      /* 祝福牆 */
      match /wishes/{wishId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'wall')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'text', 'time'])
          && validAuthor(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 300;
        allow update, delete: if false;
      }

      /* 悄悄話信箱：只有站台 ownerEmails 名單內、且信箱已驗證的
         Google 帳號讀得到。賓客寫得進去、讀不出來。 */
      match /letters/{letterId} {
        allow read: if isSiteOwner(siteId);
        allow create: if sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'text', 'time'])
          && validAuthor(request.resource.data)
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }

      /* 甜點桌 */
      match /cakes/{cakeId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'cake')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['name', 'icon', 'cake', 'emoji', 'img', 'time'])
          && validAuthor(request.resource.data)
          && isStr(request.resource.data.cake, 60)
          && isStr(request.resource.data.emoji, 8)
          && isStr(request.resource.data.img, 300);
        allow update, delete: if false;
      }

      /* 新人小測驗：只存答案陣列，不含個資 */
      match /compat/{compatId} {
        allow read: if true;
        allow create: if pageOn(siteId, 'quiz')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['answers', 'time'])
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 50
          && request.resource.data.time is number;
        /* 新人重置票數會刪除整個集合，因此開放 delete */
        allow delete: if pageOn(siteId, 'quiz') && sitePublished(siteId);
        allow update: if false;
      }

      /* 抽卡收藏：每位訪客只看得到自己的卡 */
      match /collected/{cardId} {
        allow read: if request.auth != null
          && resource.data.uid == request.auth.uid;
        allow create: if pageOn(siteId, 'draw')
          && sitePublished(siteId)
          && request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'userName', 'art', 'name', 'rarity', 'desc', 'time'])
          && isStr(request.resource.data.userName, 40)
          && isStr(request.resource.data.name, 60)
          && isStr(request.resource.data.art, 300)
          && isStr(request.resource.data.rarity, 8)
          && (!('desc' in request.resource.data) || isStr(request.resource.data.desc, 200))
          && request.resource.data.time is number;
        allow update, delete: if false;
      }

      /* 愛心計數器：只有 count 一個欄位，且只能往上加 1 */
      match /meta/hearts {
        allow read: if true;
        allow write: if pageOn(siteId, 'wall')
          && sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && (
            !exists(/databases/$(database)/documents/sites/$(siteId)/meta/hearts)
            ? request.resource.data.count == 1
            : request.resource.data.count == resource.data.count + 1
          );
      }

      /* 信件數量：賓客讀不到信件內容，但看得到「已有幾封信」。
         同樣只能一次加一，避免被亂設數字。 */
      match /meta/letterCount {
        allow read: if true;
        allow write: if sitePublished(siteId)
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && (
            !exists(/databases/$(database)/documents/sites/$(siteId)/meta/letterCount)
            ? request.resource.data.count == 1
            : request.resource.data.count == resource.data.count + 1
          );
      }

      /* ---------- 婚禮當天：桌次查詢 ----------
         名單必須公開讀取，賓客才查得到自己的位子
         （等同於會場門口那張貼出來的座位表）。
         寫入只有新人本人（ownerEmails 白名單）做得到。 */
      match /seating/{seatId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['name', 'table', 'note', 'time'])
          && isStr(request.resource.data.name, 40)
          && request.resource.data.name.size() >= 1
          && isStr(request.resource.data.table, 40)
          && request.resource.data.table.size() >= 1
          && isStr(request.resource.data.note, 100)
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 桌次圖：新人在後台上傳，前端先縮圖再以 data URL 存進文件。
         不開 Firebase Storage —— Storage 規則讀不到 Firestore，
         沒辦法用 ownerEmails 白名單判斷身分。 */
      match /seatingImages/{imageId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['img', 'title', 'order', 'time'])
          && request.resource.data.img is string
          && request.resource.data.img.size() <= 950000
          && request.resource.data.img.matches('data:image/.*')
          && isStr(request.resource.data.title, 60)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 電子祝福信：新人寫好，賓客用名字或專屬詞彙領取。
         比對在前端做，所以信件內容是公開可讀的
         —— 這裡適合寫給某人的祝福，不適合放不能被看到的祕密。
         欄位取名 terms 而不是 keys，避免和規則語言的 data.keys() 撞名。 */
      match /blessings/{blessingId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['terms', 'title', 'body', 'sign', 'isDefault', 'time'])
          && request.resource.data.terms is list
          && request.resource.data.terms.size() <= 20
          && isStr(request.resource.data.title, 60)
          && isStr(request.resource.data.body, 2000)
          && request.resource.data.body.size() >= 1
          && isStr(request.resource.data.sign, 60)
          && request.resource.data.isDefault is bool
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 首頁 Explore 區的自訂卡片：新人自己寫這場婚禮規劃了什麼。
         kind='link'  → 點了開外部連結（只收 http(s)，擋掉 javascript: 之類）
         kind='popup' → 點了跳出 body 的內文 */
      match /explore/{itemId} {
        allow read: if true;
        allow create, update: if isSiteOwner(siteId)
          && request.resource.data.keys().hasOnly(['title', 'sub', 'kind', 'url', 'body', 'order', 'time'])
          && isStr(request.resource.data.title, 40)
          && request.resource.data.title.size() >= 1
          && isStr(request.resource.data.sub, 120)
          && request.resource.data.kind in ['link', 'popup']
          && isStr(request.resource.data.url, 500)
          && (request.resource.data.kind != 'link'
              || request.resource.data.url.matches('https?://.*'))
          && isStr(request.resource.data.body, 2000)
          && request.resource.data.order is number
          && request.resource.data.time is number;
        allow delete: if isSiteOwner(siteId);
      }

      /* 其他 meta 文件一律不開放 */
      match /meta/{docId} {
        allow read: if true;
        allow write: if false;
      }
    }

    /* RSVP 建立時的欄位與商業規則驗證
       核心欄位必填；icon／tentative／meal 是多頁版表單才用得到的選填欄位。
       tentative=true 代表「未定」（此時 attending 為 false）。 */
    function isValidRsvp(data, siteId) {
      let s = site(siteId);
      return data.keys().hasOnly(['name', 'attending', 'guestCount', 'dietaryNote', 'message', 'createdAt', 'icon', 'tentative', 'meal'])
        && data.keys().hasAll(['name', 'attending', 'guestCount', 'dietaryNote', 'message', 'createdAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.attending is bool
        && data.guestCount is int && data.guestCount >= 1 && data.guestCount <= 10
        && data.dietaryNote is string && data.dietaryNote.size() <= 300
        && data.message is string && data.message.size() <= 300
        && data.createdAt == request.time
        && (!('icon' in data) || isStr(data.icon, 8))
        && (!('tentative' in data) || data.tentative is bool)
        && (!('meal' in data) || isStr(data.meal, 20))
        && sitePublished(siteId)
        && s.rsvpEnabled == true
        && request.time <= s.rsvpDeadline;
    }

    /* slugs：前端要查 slug → siteId，寫入走 Admin SDK */
    match /slugs/{slug} {
      allow read: if true;
      allow write: if false;
    }

    /* 短連結：前端只能讀，寫入走 Admin SDK */
    match /short/{code} {
      allow read: if true;
      allow write: if false;
    }
  }
}
